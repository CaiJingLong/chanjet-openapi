    "prettier": "^3.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  }
